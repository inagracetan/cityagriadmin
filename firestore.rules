rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading all documents
    match /{document=**} {
      allow read: if true;
    }

    // Activities collection
    match /activities/{activityId} {
      allow write: if true;

      match /transactions/{transactionId} {
        allow write: if true;
      }
    }

    // PR Logs collection
    match /pr_logs/{logId} {
      allow write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
